# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.cache
*.swp
*~

# .NET / NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets
*.nupkg
*.snupkg
.nuget/

# Publish / self-contained builds
publish/
publish-*/
[Pp]ublish/
[Pp]ublish-*/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Logs
*.log
log-*.txt

# Internal artefacts (не коммитим собранные exe в репозиторий)
dist/
*.exe
*.dll
*.pdb

# Инструменты и временные файлы
*.tmp
*.bak
*.orig
*.rej
